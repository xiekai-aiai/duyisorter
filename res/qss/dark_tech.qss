/* ===================================================================
 * dark_tech.qss — DuySorter 科技风深色主题
 *
 * 设计变量（来自 UI参考/色选机深度学习操作台AI+色选.html）：
 *   主色  --cyan:#22d3ee   次色 --blue:#3b82f6
 *   成功  --green:#34d399  危险 --red:#f87171  警告 --amber:#fbbf24
 *   背景  --bg:#050a14     面板 --panel:rgba(12,22,38,.78)
 *   文字  --txt:#e2edfb    次文字 --dim:#7d93b2
 *   边框  --line:rgba(56,189,248,.16)
 * =================================================================== */


/* ================ 全局 ================ */
QWidget {
    background: #050a14;
    color: #e2edfb;
    font-family: "HarmonyOS Sans SC", "HarmonyOS Sans", "Microsoft YaHei",
                 "PingFang SC", "Segoe UI", sans-serif;
    font-size: 14px;
}

/* HarmonyOS Sans 数字等宽回退（如果字体文件加载成功） */
QLabel[mono="true"],
QProgressBar,
QSpinBox, QDoubleSpinBox,
QTimeEdit, QDateEdit, QDateTimeEdit {
    font-variant-numeric: tabular-nums;
}


/* ================ 面板容器（TechFrame） ================ */
/* 所有顶层容器都建议 setObjectName("frame") 让此选择器命中 */
QFrame#frame,
QFrame[role="panel"],
TechFrame,
QGroupBox {
    background: rgba(12, 22, 38, 200);      /* --panel */
    border: 1px solid rgba(56, 189, 248, 40); /* --line */
    border-radius: 10px;
}
QGroupBox::title {
    color: #67e8f9;
    subcontrol-origin: top;
    left: 14px;
    padding: 0 6px;
    font-weight: 600;
    letter-spacing: 1px;
}


/* ================ 按钮 ================ */
QPushButton {
    cursor: pointer;
    border: 1px solid rgba(56, 189, 248, 40);
    border-radius: 8px;
    padding: 9px 16px;
    color: #e2edfb;
    font-size: 13px;
    letter-spacing: 1px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(255,255,255,12),
                                stop:1 rgba(255,255,255,4));
}
QPushButton:hover {
    border-color: rgba(56, 189, 248, 80);
    background: rgba(34, 211, 238, 26);
    color: #67e8f9;
}
QPushButton:pressed {
    padding-top: 10px;      /* 下按 1px，对应 HTML .btn:active translateY(1px) */
    padding-bottom: 8px;
}
QPushButton:disabled {
    opacity: 0.4;
    color: #54687f;
    cursor: not-allowed;
}

/* 主按钮 —— HTML .btn-primary */
QPushButton[primary="true"],
QPushButton#btnPrimary {
    border-color: rgba(34, 211, 238, 140);
    color: #031318;
    font-weight: 700;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #22d3ee,
                                stop:1 #3b82f6);
    box-shadow: 0 0 16px rgba(34, 211, 238, 90),
                0 0 30px rgba(59, 130, 246, 46);
}
QPushButton[primary="true"]:hover,
QPushButton#btnPrimary:hover {
    color: #031318;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #4de6ff,
                                stop:1 #60a5fa);
}
QPushButton[primary="true"]:disabled {
    background: rgba(56, 189, 248, 60);
    color: #081120;
    border-color: rgba(56, 189, 248, 80);
    box-shadow: none;
    opacity: 0.5;
}

/* 危险按钮 —— HTML .btn-danger */
QPushButton[danger="true"],
QPushButton#btnDanger {
    border-color: rgba(248, 113, 113, 80);
}
QPushButton[danger="true"]:hover,
QPushButton#btnDanger:hover {
    border-color: rgba(248, 113, 113, 150);
    background: rgba(248, 113, 113, 30);
    color: #f87171;
}

/* 选中/激活按钮 —— HTML .btn.on / .seg.active */
QPushButton[checked="true"],
QPushButton[active="true"],
QPushButton#btnOn {
    border-color: #22d3ee;
    color: #67e8f9;
    background: rgba(34, 211, 238, 40);
    box-shadow: inset 0 0 12px rgba(34, 211, 238, 64);
}

/* 小按钮 */
QPushButton[small="true"],
QPushButton#btnSm {
    padding: 6px 11px;
    font-size: 12px;
    border-radius: 7px;
}

/* 标签按钮（颜色 chip 类，如类别 0 合格 / 类别 1 异物）*/
QPushButton#clsChip,
QPushButton[role="chip"] {
    padding: 7px 14px;
    border-radius: 8px;
    border: 1px solid rgba(56, 189, 248, 40);
    background: rgba(255, 255, 255, 5);
}


/* ================ 输入框 ================ */
QLineEdit, QSpinBox, QDoubleSpinBox,
QDateTimeEdit, QDateEdit, QTimeEdit {
    background: #081120;
    border: 1px solid rgba(56, 189, 248, 40);
    border-radius: 6px;
    padding: 6px 10px;
    color: #e2edfb;
    selection-background-color: rgba(34, 211, 238, 120);
    selection-color: #031318;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateTimeEdit:focus, QDateEdit:focus, QTimeEdit:focus {
    border-color: rgba(56, 189, 248, 150);
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateTimeEdit::up-button, QDateEdit::up-button, QTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    height: 14px;
    background: rgba(34, 211, 238, 20);
    border-left: 1px solid rgba(56, 189, 248, 40);
    border-bottom: 1px solid rgba(56, 189, 248, 40);
}
QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateTimeEdit::down-button, QDateEdit::down-button, QTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    height: 14px;
    background: rgba(34, 211, 238, 20);
    border-left: 1px solid rgba(56, 189, 248, 40);
}


/* ================ ComboBox ================ */
QComboBox {
    background: #081120;
    border: 1px solid rgba(56, 189, 248, 40);
    border-radius: 6px;
    padding: 6px 10px;
    color: #e2edfb;
}
QComboBox:hover { border-color: rgba(56, 189, 248, 80); }
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid rgba(56, 189, 248, 40);
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}
QComboBox QAbstractItemView {
    background: #081120;
    border: 1px solid rgba(56, 189, 248, 80);
    border-radius: 6px;
    outline: 0;
    selection-background-color: rgba(34, 211, 238, 60);
    selection-color: #67e8f9;
}


/* ================ 表格 / 列表 ================ */
QTableWidget, QTableView,
QListWidget, QListView,
QTreeWidget, QTreeView {
    background: #081120;
    border: 1px solid rgba(56, 189, 248, 40);
    border-radius: 8px;
    gridline-color: rgba(56, 189, 248, 30);
    alternate-background-color: #0d1a2d;
    selection-background-color: rgba(34, 211, 238, 60);
    selection-color: #e2edfb;
    outline: 0;
}
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(34, 211, 238, 40),
                                stop:1 rgba(59, 130, 246, 20));
    color: #67e8f9;
    border: 0;
    border-right: 1px solid rgba(56, 189, 248, 40);
    border-bottom: 1px solid rgba(56, 189, 248, 40);
    padding: 6px 10px;
    font-weight: 600;
    letter-spacing: 1px;
}
QHeaderView::section:first { border-top-left-radius: 7px; }
QHeaderView::section:last  { border-top-right-radius: 7px; border-right: 0; }


/* ================ 滚动条 ================ */
QScrollBar:vertical {
    background: #081120;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: rgba(34, 211, 238, 80);
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover { background: #22d3ee; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: transparent; }
QScrollBar:horizontal {
    background: #081120;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: rgba(34, 211, 238, 80);
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover { background: #22d3ee; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: transparent; }


/* ================ 进度条 ================ */
QProgressBar {
    background: rgba(56, 189, 248, 40);
    border: 1px solid rgba(56, 189, 248, 60);
    border-radius: 7px;
    height: 14px;
    text-align: center;
    color: #e2edfb;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #22d3ee,
                                stop:1 #3b82f6);
    border-radius: 6px;
    box-shadow: 0 0 10px #22d3ee;
}


/* ================ Slider ================ */
QSlider::groove:horizontal {
    height: 6px;
    background: rgba(56, 189, 248, 40);
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #22d3ee,
                                stop:1 #3b82f6);
    border-radius: 3px;
    box-shadow: 0 0 6px #22d3ee;
}
QSlider::handle:horizontal {
    width: 16px; height: 16px; margin: -6px 0;
    background: #22d3ee;
    border-radius: 8px;
    box-shadow: 0 0 10px #22d3ee;
}
QSlider::handle:horizontal:hover { background: #67e8f9; }


/* ================ Tab ================ */
QTabWidget::pane {
    border: 1px solid rgba(56, 189, 248, 40);
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    background: rgba(255, 255, 255, 5);
    border: 1px solid rgba(56, 189, 248, 40);
    border-bottom: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 8px 18px;
    color: #7d93b2;
}
QTabBar::tab:selected, QTabBar::tab:hover {
    color: #67e8f9;
    background: rgba(34, 211, 238, 30);
    border-color: rgba(56, 189, 248, 80);
}


/* ================ ToolTip / Label ================ */
QToolTip {
    background: #081120;
    border: 1px solid rgba(56, 189, 248, 80);
    border-radius: 6px;
    color: #e2edfb;
    padding: 5px 8px;
}
QLabel[heading="true"] {
    color: #67e8f9;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 1px;
}
QLabel[dim="true"] { color: #7d93b2; font-size: 12px; }
QLabel[status="online"] { color: #34d399; }
QLabel[status="offline"] { color: #f87171; }
QLabel[status="warn"]   { color: #fbbf24; }


/* ================ CheckBox / RadioButton ================ */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid rgba(56, 189, 248, 80);
    background: #081120;
    border-radius: 4px;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #22d3ee,
                                stop:1 #3b82f6);
    border-color: #22d3ee;
}


/* ================ Menu ================ */
QMenu {
    background: #081120;
    border: 1px solid rgba(56, 189, 248, 80);
    border-radius: 8px;
    padding: 4px;
}
QMenu::item { padding: 6px 20px; border-radius: 5px; color: #e2edfb; }
QMenu::item:selected {
    background: rgba(34, 211, 238, 50);
    color: #67e8f9;
}


/* ================ Dialog / Message ================ */
QDialog, QMessageBox {
    background: #050a14;
}
QMessageBox QLabel { color: #e2edfb; }


/* ================ GroupBox 内容 ================ */
QGroupBox {
    margin-top: 22px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
}


/* ================ ScrollArea ================ */
QScrollArea { border: 0; background: transparent; }


/* ================ 数值显示 Chip（HTML .num） ================ */
QLabel#numChip,
QLabel[mono="true"][chip="true"] {
    font-family: "Consolas", "JetBrains Mono", "SF Mono", "HarmonyOS Sans", monospace;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: #67e8f9;
}


/* ================ 分隔线 ================ */
QFrame[role="hline"] {
    background: rgba(56, 189, 248, 40);
    max-height: 1px;
}
QFrame[role="vline"] {
    background: rgba(56, 189, 248, 40);
    max-width: 1px;
}


/* ================ DuySorter 视频画布（HTML .canvas-box） ================ */
QLabel#canvasBox,
QFrame[role="stage"] {
    border: 1px solid rgba(56, 189, 248, 80);
    border-radius: 8px;
    background: #0b1017;
}
QLabel#canvasBox {
    box-shadow: 0 0 40px rgba(34, 211, 238, 26),
                0 10px 40px rgba(0, 0, 0, 128);
}
