####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/app || mkdir -p $(INSTALL_ROOT)/opt/app
	$(QINSTALL_PROGRAM) app/$(QMAKE_TARGET) $(INSTALL_ROOT)/opt/app/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/app/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/app/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/app/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

