            }
            showColumn(5);
            showColumn(6);
        }

        if (struCnfg.struLevelInfo[0].nViewTotal == 2 &&struCnfg.struLevelInfo[1].nViewTotal == 1
                && struCnfg.struLevelInfo[2].nViewTotal == 2) {
            for (int i = 0; i < struCnfg.struLevelInfo[0].nUnitLevelTotal; i++) {
