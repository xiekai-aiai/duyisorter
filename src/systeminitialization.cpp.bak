                        if((struGsh.struVer.sUnit[j][i][0] != 255) && (struGsh.struVer.sUnit[j][i][1] != 255)){
                            cameraListLabel[i+1][j+1]->setText(myLan.normal);
                            cameraListLabel[i+1][j+1]->setStyleSheet("color:black");
