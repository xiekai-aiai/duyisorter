                        cameraListLabel[id/2+1][2]->setText(myLan.normal);
                        cameraListLabel[id/2+1][2]->setStyleSheet("color:black");
                    } else {
                        cameraListLabel[id/2+1][2]->setText(myLan.abnormal);
                        cameraListLabel[id/2+1][2]->setStyleSheet("color:red");
