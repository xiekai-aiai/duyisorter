                            cameraListLabel[id/2+1][3]->setText(myLan.normal);
                            cameraListLabel[id/2+1][3]->setStyleSheet("color:black");
                        }
                        else {
                            cameraListLabel[id/2+1][3]->setText(myLan.abnormal);
                            cameraListLabel[id/2+1][3]->setStyleSheet("color:red");
                        }
                    }

                        if((struGsh.struVer.sUnit[0][i/2][0] != 255) && (struGsh.struVer.sUnit[0][i/2][1] != 255)){
                            cameraListLabel[i/2+1][1]->setText(myLan.normal);
                            cameraListLabel[i/2+1][1]->setStyleSheet("color:black");
                        }
                        else
                        {
                            cameraListLabel[i/2+1][1]->setText(myLan.abnormal);
                            cameraListLabel[i/2+1][1]->setStyleSheet("color:red");
                        }


                }
            }

            if(struCnfg.struLevelInfo[0].nViewTotal == 2 && struCnfg.struLevelInfo[1].nViewTotal == 2)
            {
                for(int i = 0; i < struCnfg.struLevelInfo[0].nUnitLevelTotal; i++){
                    id = struCnfg.struLevelInfo[0].nUnitId[i];
                    if(id%2 ==0){
                        if((struGsh.struVer.sUnit[0][i][0] != 255) && (struGsh.struVer.sUnit[0][i][1] != 255)){
                            cameraListLabel[id/2+1][1]->setText(myLan.normal);
                            cameraListLabel[id/2+1][1]->setStyleSheet("color:black");
                        }
                        else {
                            cameraListLabel[id/2+1][1]->setText(myLan.abnormal);
                            cameraListLabel[id/2+1][1]->setStyleSheet("color:red");
                        }
                    }
                    else {
                        if((struGsh.struVer.sUnit[0][i][0] != 255) && (struGsh.struVer.sUnit[0][i][1] != 255)){
                            cameraListLabel[id/2+1][2]->setText(myLan.normal);
                            cameraListLabel[id/2+1][2]->setStyleSheet("color:black");
                        }
                        else {
                            cameraListLabel[id/2+1][2]->setText(myLan.abnormal);
                            cameraListLabel[id/2+1][2]->setStyleSheet("color:red");
                        }
                    }

                    id = struCnfg.struLevelInfo[1].nUnitId[i];
                    if(id%2 ==0){
                        if((struGsh.struVer.sUnit[1][i][0] != 255) && (struGsh.struVer.sUnit[1][i][1] != 255)){
                            cameraListLabel[id/2+1][3]->setText(myLan.normal);
                            cameraListLabel[id/2+1][3]->setStyleSheet("color:black");
                        }
                        else {
                            cameraListLabel[id/2+1][3]->setText(myLan.abnormal);
                            cameraListLabel[id/2+1][3]->setStyleSheet("color:red");
                        }
                    }
                    else {
                        if((struGsh.struVer.sUnit[1][i][0] != 255) && (struGsh.struVer.sUnit[1][i][1] != 255)){
                            cameraListLabel[id/2+1][4]->setText(myLan.normal);
                            cameraListLabel[id/2+1][4]->setStyleSheet("color:black");
                        }
                        else {
                            cameraListLabel[id/2+1][4]->setText(myLan.abnormal);
                            cameraListLabel[id/2+1][4]->setStyleSheet("color:red");
                        }
                    }
                }
                showColumn(5);
            }
             break;
    }

        if (struCnfg.nLevelTotal == 3) {
            cameraListLabel[0][0]->setText(myLan.chute);
            if(struCnfg.struLevelInfo[0].nViewTotal == 1 &&struCnfg.struLevelInfo[1].nViewTotal == 1
                    && struCnfg.struLevelInfo[2].nViewTotal == 1)
            {
                cameraListLabel[0][1]->setText(myLan.upper_layer);
                cameraListLabel[0][2]->setText(myLan.mid_layer);
                cameraListLabel[0][3]->setText(myLan.lower_layer);
            }
            if(struCnfg.struLevelInfo[0].nViewTotal == 2 &&struCnfg.struLevelInfo[1].nViewTotal == 1
                    && struCnfg.struLevelInfo[2].nViewTotal == 1)
            {
                cameraListLabel[0][1]->setText(myLan.upper + "-" + myLan.front);
                cameraListLabel[0][2]->setText(myLan.upper + "-" + myLan.rear);
                cameraListLabel[0][3]->setText(myLan.mid_layer);
                cameraListLabel[0][4]->setText(myLan.lower_layer);
            }
            if(struCnfg.struLevelInfo[0].nViewTotal == 1 &&struCnfg.struLevelInfo[1].nViewTotal == 2
                    && struCnfg.struLevelInfo[2].nViewTotal == 1)
            {
                cameraListLabel[0][1]->setText(myLan.upper_layer);
                cameraListLabel[0][2]->setText(myLan.mid_layer + "-" + myLan.front);
                cameraListLabel[0][3]->setText(myLan.mid_layer + "-" + myLan.rear);
                cameraListLabel[0][4]->setText(myLan.lower_layer);
            }
            if(struCnfg.struLevelInfo[0].nViewTotal == 1 &&struCnfg.struLevelInfo[1].nViewTotal == 1
                    && struCnfg.struLevelInfo[2].nViewTotal == 2)
            {
                cameraListLabel[0][1]->setText(myLan.upper_layer);
                cameraListLabel[0][2]->setText(myLan.mid_layer);
                cameraListLabel[0][3]->setText(myLan.lower + "-" + myLan.front);
                cameraListLabel[0][4]->setText(myLan.lower + "-" + myLan.rear);
            }
            if(struCnfg.struLevelInfo[0].nViewTotal == 2 &&struCnfg.struLevelInfo[1].nViewTotal == 2
                    && struCnfg.struLevelInfo[2].nViewTotal == 1)
            {
                cameraListLabel[0][1]->setText(myLan.upper + "-" + myLan.front);
                cameraListLabel[0][2]->setText(myLan.upper + "-" + myLan.rear);
                cameraListLabel[0][3]->setText(myLan.mid + "-" + myLan.front);
                cameraListLabel[0][4]->setText(myLan.mid + "-" + myLan.rear);
                cameraListLabel[0][5]->setText(myLan.lower_layer);

            }
            if(struCnfg.struLevelInfo[0].nViewTotal == 2 &&struCnfg.struLevelInfo[1].nViewTotal == 1
                    && struCnfg.struLevelInfo[2].nViewTotal == 2)
            {
                cameraListLabel[0][1]->setText(myLan.upper + "-" + myLan.front);
                cameraListLabel[0][2]->setText(myLan.upper + "-" + myLan.rear);
                cameraListLabel[0][3]->setText(myLan.mid_layer);
                cameraListLabel[0][4]->setText(myLan.lower + "-" + myLan.front);
                cameraListLabel[0][5]->setText(myLan.lower + "-" + myLan.rear);

            }
            if(struCnfg.struLevelInfo[0].nViewTotal == 1 &&struCnfg.struLevelInfo[1].nViewTotal == 2
                    && struCnfg.struLevelInfo[2].nViewTotal == 2)
            {
                cameraListLabel[0][1]->setText(myLan.upper_layer);
                cameraListLabel[0][2]->setText(myLan.mid + "-" + myLan.front);
                cameraListLabel[0][3]->setText(myLan.mid + "-" + myLan.rear);
                cameraListLabel[0][4]->setText(myLan.lower + "-" + myLan.front);
                cameraListLabel[0][5]->setText(myLan.lower + "-" + myLan.rear);

            }
            if(struCnfg.struLevelInfo[0].nViewTotal == 2 &&struCnfg.struLevelInfo[1].nViewTotal == 2
                    && struCnfg.struLevelInfo[2].nViewTotal == 2)
            {
                cameraListLabel[0][1]->setText(myLan.upper + "-" + myLan.front);
                cameraListLabel[0][2]->setText(myLan.upper + "-" + myLan.rear);
                cameraListLabel[0][3]->setText(myLan.mid + "-" + myLan.front);
                cameraListLabel[0][4]->setText(myLan.mid + "-" + myLan.rear);
                cameraListLabel[0][5]->setText(myLan.lower + "-" + myLan.front);
                cameraListLabel[0][6]->setText(myLan.lower + "-" + myLan.rear);

            }


        } else {

            cameraListLabel[0][0]->setText(myLan.chute);

            if(struCnfg.struLevelInfo[0].nViewTotal == 1 && struCnfg.struLevelInfo[1].nViewTotal == 1){
                cameraListLabel[0][1]->setText(myLan.upper_layer);
                cameraListLabel[0][2]->setText(myLan.lower_layer);
            }

            if(struCnfg.struLevelInfo[0].nViewTotal == 2 && struCnfg.struLevelInfo[1].nViewTotal == 1){
                cameraListLabel[0][1]->setText(myLan.upper + "-" + myLan.front);
                cameraListLabel[0][2]->setText(myLan.upper + "-" + myLan.rear);
                cameraListLabel[0][3]->setText(myLan.lower_layer);
            }

            if(struCnfg.struLevelInfo[0].nViewTotal == 1 && struCnfg.struLevelInfo[1].nViewTotal == 2){
                cameraListLabel[0][1]->setText(myLan.upper_layer);
                cameraListLabel[0][2]->setText(myLan.lower + "-" + myLan.front);
                cameraListLabel[0][3]->setText(myLan.lower + "-" + myLan.rear);
            }

            if(struCnfg.struLevelInfo[0].nViewTotal == 2 && struCnfg.struLevelInfo[1].nViewTotal == 2){
                cameraListLabel[0][1]->setText(myLan.upper + "-" + myLan.front);
                cameraListLabel[0][2]->setText(myLan.upper + "-" + myLan.rear);
                cameraListLabel[0][3]->setText(myLan.lower + "-" + myLan.front);
                cameraListLabel[0][4]->setText(myLan.lower + "-" + myLan.rear);
            }
        }

        for (i = ((struCnfg.struLevelInfo[0].nViewTotal == 1)?struCnfg.struLevelInfo[0].nUnitLevelTotal:struCnfg.struLevelInfo[0].nUnitLevelTotal/2)+1; i < MAX_UNIT/2+1; i++){
            for(j = 0; j < MAX_BACKGROUND_GROUP+3 ; j++){
                    cameraListLabel[i][j]->hide();
            }
        }
        break;



    case MACHINE_CF:
        for(i = 1; i < struCnfg.struLevelInfo[0].nUnitLevelTotal+1; i++){
            cameraListLabel[(i+1)/2][0]->setText(QString("%1").arg(i/2));
            for (j = 0; j < struCnfg.nLevelTotal; j++) {
                id = struCnfg.struLevelInfo[j].nUnitId[i-1];
                front_rear = (id%2 == 0) ? 1 : 2;

                if((struGsh.struVer.sUnit[j][i-1][0] != 255) && (struGsh.struVer.sUnit[j][i-1][1] != 255)) {
                      cameraListLabel[(i+1)/2][front_rear]->setText(myLan.normal);
                      cameraListLabel[(i+1)/2][front_rear]->setStyleSheet("color:black");
                }
                else {
                      cameraListLabel[(i+1)/2][front_rear]->setText(myLan.abnormal);
                      cameraListLabel[(i+1)/2][front_rear]->setStyleSheet("color:red");
                }
            }
        }
        cameraListLabel[0][0]->setText(myLan.chute);
//        cameraListLabel[0][0]->setText("通道");
        cameraListLabel[0][1]->setText(myLan.front_view);
        cameraListLabel[0][2]->setText(myLan.rear_view);

        for(i = 1; i < struCnfg.struLevelInfo[0].nUnitLevelTotal+1; i++){
            cameraListLabel[(i+1)/2][0]->setText(QString("%1").arg(i/2));
            for (j = 0; j < struCnfg.nLevelTotal; j++) {
                id = struCnfg.struLevelInfo[j].nUnitId[i-1];
                front_rear = (id%2 == 0) ? 3 : 4;
            }
        }
        cameraListLabel[0][3]->setText(myLan.infra+"-"+myLan.front);
        cameraListLabel[0][4]->setText(myLan.infra+"-"+myLan.rear);

        if(struCnfg.aiEnable == 1){
            cameraListLabel[0][3]->setText("AI");
            for (int k = 1; k < struCnfg.struLevelInfo[0].nUnitLevelTotal+1; k++) {
                int nAddr = struCnfg.struLevelInfo[0].nUnitId[k-1];
                if(nAddr%2 == 0){
                    if(struGsh.aiResult[(k-1)/2] != QString("")){
                        cameraListLabel[(k+1)/2][3]->setText(myLan.normal);
                        cameraListLabel[(k+1)/2][3]->setStyleSheet("color:black");
                    }else{
                        cameraListLabel[(k+1)/2][3]->setText(myLan.abnormal);
                        cameraListLabel[(k+1)/2][3]->setStyleSheet("color:red");
                    }
                }
            }
        }

        showColumn(5);
        for(i = 0; i < struCnfg.struLevelInfo[0].nUnitLevelTotal/2+1; i++){
            if (!(struCnfe.nDerivedDevType & 0x0001)) {
                cameraListLabel[i][1]->hide();
            }
            if (!(struCnfe.nDerivedDevType & 0x0002)) {
                cameraListLabel[i][2]->hide();
            }
            if ((struCnfe.nDerivedDevType & 0x01000100) != 0x01000100) {
                cameraListLabel[i][3]->hide();
            }
            if ((struCnfe.nDerivedDevType & 0x01000200) != 0x01000200) {
                cameraListLabel[i][4]->hide();
            }
        }

        if(struCnfg.aiEnable == 1){
            cameraListLabel[i][3]->show();
        }

        for(i = struCnfg.struLevelInfo[0].nUnitLevelTotal/2+1; i < MAX_UNIT/2+1; i++) {
            for(j = 0; j < MAX_BACKGROUND_GROUP + 3; j++){
                cameraListLabel[i][j]->hide();
            }
        }
        break;

    default:
        break;
    }
}

/* RS机型下刷新前置板通信自检页面 */
void communicationList::commuUpdateCameraRS()
{
    int front_rear;
    int id;

    /* 主配 */
    for (int i = 1; i < struCnfg.struLevelInfo[0].nUnitLevelTotal+1; i++) {
        cameraListLabel[(i+1)/2][0]->setText(QString("%1").arg(i/2));
        for (int j = 0; j < struCnfg.nLevelTotal; j++) {
            id = struCnfg.struLevelInfo[0].nUnitId[i-1];
            front_rear = (id%2 == 0) ? 1 : 2;

            if((struGsh.struVer.sUnit[j][i-1][0] != 255) && (struGsh.struVer.sUnit[j][i-1][1] != 255)) {
                  cameraListLabel[(i+1)/2][front_rear]->setText(myLan.normal);
                  cameraListLabel[(i+1)/2][front_rear]->setStyleSheet("color:black");
            } else {
                  cameraListLabel[(i+1)/2][front_rear]->setText(myLan.abnormal);
                  cameraListLabel[(i+1)/2][front_rear]->setStyleSheet("color:red");
            }
        }
    }
    cameraListLabel[0][0]->setText(myLan.chute);
    cameraListLabel[0][1]->setText(myLan.front_view);
    cameraListLabel[0][2]->setText(myLan.rear_view);

    /* 辅配 */
    hideColumn(4);
    hideColumn(5);

    for(int i = struCnfg.struLevelInfo[0].nUnitLevelTotal/2+1; i < MAX_UNIT/2+1; i++) {
        for (int j = 0; j < 5; j++) {
            cameraListLabel[i][j]->hide();
        }
    }
}

/* 更新恒流源板版本信息 */
void communicationList::commuUpdateLightSrc()
{
    for (int i = 0; i < struCnfg.nLampAINum; i++) {
        m_lightSrcLabel[i][0]->setText(QString("%1").arg(i+1));

        /** 若恒流源板未使用则显示"--" */
        if (struCnfg.nCurSrcBoradLampNum[i] == 0) {
            m_lightSrcLabel[i][1]->setText("--");
            m_lightSrcLabel[i][1]->setStyleSheet("color:black");
        } else if (struGsh.struVer.sLightSrc[i][0] != 255 && struGsh.struVer.sLightSrc[i][1] != 255) {
            m_lightSrcLabel[i][1]->setText(myLan.normal);
            m_lightSrcLabel[i][1]->setStyleSheet("color:black");
        } else {
            m_lightSrcLabel[i][1]->setText(myLan.abnormal);
            m_lightSrcLabel[i][1]->setStyleSheet("color:red");
        }
    }

    for (int i = struCnfg.nLampAINum; i < MAX_LIGHT_SOURCE; i++) {
        m_lightSrcLabel[i][0]->hide();
        m_lightSrcLabel[i][1]->hide();
    }
}

/* 隐藏某一列 */
void communicationList::hideColumn(int index)
{
    for (int i = 0; i < MAX_UNIT/2+1; i++) {
        cameraListLabel[i][index-1]->hide();
    }
}

/* 显示某一列 */
void communicationList::showColumn(int index)
{
    for (int i = 0; i < MAX_UNIT/2+1; i++) {
        cameraListLabel[i][index-1]->show();
    }
}

void communicationList::updateCommunicationResultSlt()
{
    commuUpdateInterface();
    commuUpdateCtrl();
    commuUpdateCamera();
    /*恒流源板状态检测*/
    commuUpdateLightSrc();
}

communicationList::communicationList(QWidget *parent) :
    QWidget(parent)
{
    int i, j;
    config = g_Config::getInstance();

    /*布局管理*/
    /* 接口板 */
    commListGridLayout = new QGridLayout();
    commListGridLayout->setSpacing(2);
    commListGridLayout->setContentsMargins(50,0,50,10);

    interfaceBoardListGroup = new myGroupBox("");
