                if (id%2 ==0) {
                    if((struGsh.struVer.sUnit[1][i][0] != 255) && (struGsh.struVer.sUnit[1][i][1] != 255)){
                        cameraListLabel[id/2+1][3]->setText(myLan.normal);
                        cameraListLabel[id/2+1][3]->setStyleSheet("color:black");
                    } else {
                        cameraListLabel[id/2+1][3]->setText(myLan.abnormal);
