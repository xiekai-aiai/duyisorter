}

void communicationList::commuUpdateCamera()
{
    int i, j;
    int id = 0;
    int front_rear = 0;
    hideColumn(6);
    hideColumn(7);

    hideColumn(5);
    switch(struCnfe.nMachine) {
    case MACHINE_TD:
        for(i = 0; i < ((struCnfg.struLevelInfo[0].nViewTotal == 1)?struCnfg.struLevelInfo[0].nUnitLevelTotal:struCnfg.struLevelInfo[0].nUnitLevelTotal/2); i++){
            cameraListLabel[i+1][0]->setText(QString("%1").arg(i+1));
        }
        switch(struCnfg.nLevelTotal){
        case 3:
        if(struCnfg.struLevelInfo[0].nViewTotal == 1 &&struCnfg.struLevelInfo[1].nViewTotal == 1
                && struCnfg.struLevelInfo[2].nViewTotal == 1) {
            for (int i = 0; i < struCnfg.struLevelInfo[0].nUnitLevelTotal; i++){
                for (j = 0; j < struCnfg.nLevelTotal; j++){
                    if((struGsh.struVer.sUnit[j][i][0] != 255) && (struGsh.struVer.sUnit[j][i][1] != 255)){
                        cameraListLabel[i+1][j+1]->setText(myLan.normal);
                        cameraListLabel[i+1][j+1]->setStyleSheet("color:black");
                    } else {
                        cameraListLabel[i+1][j+1]->setText(myLan.abnormal);
                        cameraListLabel[i+1][j+1]->setStyleSheet("color:red");
                    }
                }
            }
        }

        if(struCnfg.struLevelInfo[0].nViewTotal == 2 &&struCnfg.struLevelInfo[1].nViewTotal == 1
                && struCnfg.struLevelInfo[2].nViewTotal == 1) {
            for (int i = 0; i < struCnfg.struLevelInfo[0].nUnitLevelTotal; i++){
                id = struCnfg.struLevelInfo[0].nUnitId[i];
                if (id%2 ==0) {
                    if((struGsh.struVer.sUnit[0][i][0] != 255) && (struGsh.struVer.sUnit[0][i][1] != 255)){
                        cameraListLabel[id/2+1][1]->setText(myLan.normal);
                        cameraListLabel[id/2+1][1]->setStyleSheet("color:black");
                    }
                    else {
                        cameraListLabel[id/2+1][1]->setText(myLan.abnormal);
                        cameraListLabel[id/2+1][1]->setStyleSheet("color:red");
                    }
                } else {
                    if((struGsh.struVer.sUnit[0][i][0] != 255) && (struGsh.struVer.sUnit[0][i][1] != 255)){
                        cameraListLabel[id/2+1][2]->setText(myLan.normal);
                        cameraListLabel[id/2+1][2]->setStyleSheet("color:black");
                    } else {
                        cameraListLabel[id/2+1][2]->setText(myLan.abnormal);
                        cameraListLabel[id/2+1][2]->setStyleSheet("color:red");
                    }
                }
                for(j = 1; j < struCnfg.nLevelTotal; j++){
                    if((struGsh.struVer.sUnit[j][i/2][0] != 255) && (struGsh.struVer.sUnit[j][i/2][1] != 255)){
                        cameraListLabel[i/2+1][j+1+1]->setText(myLan.normal);
                        cameraListLabel[i/2+1][j+1+1]->setStyleSheet("color:black");
                    } else {
                        cameraListLabel[i/2+1][j+1+1]->setText(myLan.abnormal);
                        cameraListLabel[i/2+1][j+1+1]->setStyleSheet("color:red");
                    }
                }
            }
            showColumn(5);
        }

        if(struCnfg.struLevelInfo[0].nViewTotal == 1 &&struCnfg.struLevelInfo[1].nViewTotal == 2
                && struCnfg.struLevelInfo[2].nViewTotal == 1) {
            for (int i = 0; i < struCnfg.struLevelInfo[1].nUnitLevelTotal; i++) {
                id = struCnfg.struLevelInfo[1].nUnitId[i];
                if (id%2 ==0) {
                    if((struGsh.struVer.sUnit[1][i][0] != 255) && (struGsh.struVer.sUnit[1][i][1] != 255)){
                        cameraListLabel[id/2+1][2]->setText(myLan.normal);
                        cameraListLabel[id/2+1][2]->setStyleSheet("color:black");
                    } else {
                        cameraListLabel[id/2+1][2]->setText(myLan.abnormal);
                        cameraListLabel[id/2+1][2]->setStyleSheet("color:red");
                    }
                } else {
                    if((struGsh.struVer.sUnit[1][i][0] != 255) && (struGsh.struVer.sUnit[1][i][1] != 255)){
                        cameraListLabel[id/2+1][3]->setText(myLan.normal);
                        cameraListLabel[id/2+1][3]->setStyleSheet("color:black");
                    } else {
                        cameraListLabel[id/2+1][3]->setText(myLan.abnormal);
                        cameraListLabel[id/2+1][3]->setStyleSheet("color:red");
                    }
                }

                if((struGsh.struVer.sUnit[0][i/2][0] != 255) && (struGsh.struVer.sUnit[0][i/2][1] != 255)){
                    cameraListLabel[i/2+1][1]->setText(myLan.normal);
                    cameraListLabel[i/2+1][1]->setStyleSheet("color:black");
                } else {
                    cameraListLabel[i/2+1][1]->setText(myLan.abnormal);
                    cameraListLabel[i/2+1][1]->setStyleSheet("color:red");
                }
                if((struGsh.struVer.sUnit[2][i/2][0] != 255) && (struGsh.struVer.sUnit[2][i/2][1] != 255)){
                    cameraListLabel[i/2+1][4]->setText(myLan.normal);
                    cameraListLabel[i/2+1][4]->setStyleSheet("color:black");
                } else {
                    cameraListLabel[i/2+1][4]->setText(myLan.abnormal);
                    cameraListLabel[i/2+1][4]->setStyleSheet("color:red");
                }
            }
            showColumn(5);
        }

        if (struCnfg.struLevelInfo[0].nViewTotal == 1 &&struCnfg.struLevelInfo[1].nViewTotal == 1
                && struCnfg.struLevelInfo[2].nViewTotal == 2) {
            for (int i = 0; i < struCnfg.struLevelInfo[2].nUnitLevelTotal; i++){
                id = struCnfg.struLevelInfo[2].nUnitId[i];
                if (id%2 ==0) {
                    if ((struGsh.struVer.sUnit[2][i][0] != 255) && (struGsh.struVer.sUnit[2][i][1] != 255)){
                        cameraListLabel[id/2+1][3]->setText(myLan.normal);
                        cameraListLabel[id/2+1][3]->setStyleSheet("color:black");
                    } else {
                        cameraListLabel[id/2+1][3]->setText(myLan.abnormal);
                        cameraListLabel[id/2+1][3]->setStyleSheet("color:red");
                    }
                } else {
                    if ((struGsh.struVer.sUnit[2][i][0] != 255) && (struGsh.struVer.sUnit[2][i][1] != 255)){
                        cameraListLabel[id/2+1][4]->setText(myLan.normal);
                        cameraListLabel[id/2+1][4]->setStyleSheet("color:black");
                    } else {
                        cameraListLabel[id/2+1][4]->setText(myLan.abnormal);
                        cameraListLabel[id/2+1][4]->setStyleSheet("color:red");
                    }
                }

                if ((struGsh.struVer.sUnit[0][i/2][0] != 255) && (struGsh.struVer.sUnit[0][i/2][1] != 255)){
                    cameraListLabel[i/2+1][1]->setText(myLan.normal);
                    cameraListLabel[i/2+1][1]->setStyleSheet("color:black");
                } else {
                    cameraListLabel[i/2+1][1]->setText(myLan.abnormal);
                    cameraListLabel[i/2+1][1]->setStyleSheet("color:red");
                }
                if ((struGsh.struVer.sUnit[1][i/2][0] != 255) && (struGsh.struVer.sUnit[1][i][1] != 255)){
                    cameraListLabel[i/2+1][2]->setText(myLan.normal);
                    cameraListLabel[i/2+1][2]->setStyleSheet("color:black");
                } else {
                    cameraListLabel[i/2+1][2]->setText(myLan.abnormal);
                    cameraListLabel[i/2+1][2]->setStyleSheet("color:red");
                }

            }
            showColumn(5);
        }

        if(struCnfg.struLevelInfo[0].nViewTotal == 2 &&struCnfg.struLevelInfo[1].nViewTotal == 2
                && struCnfg.struLevelInfo[2].nViewTotal == 1) {
            for (int i = 0; i < struCnfg.struLevelInfo[0].nUnitLevelTotal; i++) {
                id = struCnfg.struLevelInfo[0].nUnitId[i];
                if (id%2 ==0) {
                    if((struGsh.struVer.sUnit[0][i][0] != 255) && (struGsh.struVer.sUnit[0][i][1] != 255)){
